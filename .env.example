# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/living360?schema=public"

# NextAuth — NEXTAUTH_URL must be the public https address in production (share links use the
# address the app is opened on). Generate the secret with:  openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Android app (TWA) verification — see ANDROID.md
ANDROID_PACKAGE_NAME="in.living360.app"
ANDROID_SHA256_FINGERPRINTS=""
